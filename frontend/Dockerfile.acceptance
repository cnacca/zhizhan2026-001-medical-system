FROM node:22-alpine AS build

WORKDIR /workspace

RUN corepack enable

ARG VITE_ACCEPTANCE_MODE
ARG VITE_ACCEPTANCE_DOCTOR_USERNAME
ARG VITE_ACCEPTANCE_DOCTOR_PASSWORD
ARG VITE_ACCEPTANCE_CS_USERNAME
ARG VITE_ACCEPTANCE_CS_PASSWORD
ARG VITE_ACCEPTANCE_PRODUCTION_USERNAME
ARG VITE_ACCEPTANCE_PRODUCTION_PASSWORD
ARG VITE_ACCEPTANCE_ADMIN_USERNAME
ARG VITE_ACCEPTANCE_ADMIN_PASSWORD

ENV VITE_ACCEPTANCE_MODE=${VITE_ACCEPTANCE_MODE}
ENV VITE_ACCEPTANCE_DOCTOR_USERNAME=${VITE_ACCEPTANCE_DOCTOR_USERNAME}
ENV VITE_ACCEPTANCE_DOCTOR_PASSWORD=${VITE_ACCEPTANCE_DOCTOR_PASSWORD}
ENV VITE_ACCEPTANCE_CS_USERNAME=${VITE_ACCEPTANCE_CS_USERNAME}
ENV VITE_ACCEPTANCE_CS_PASSWORD=${VITE_ACCEPTANCE_CS_PASSWORD}
ENV VITE_ACCEPTANCE_PRODUCTION_USERNAME=${VITE_ACCEPTANCE_PRODUCTION_USERNAME}
ENV VITE_ACCEPTANCE_PRODUCTION_PASSWORD=${VITE_ACCEPTANCE_PRODUCTION_PASSWORD}
ENV VITE_ACCEPTANCE_ADMIN_USERNAME=${VITE_ACCEPTANCE_ADMIN_USERNAME}
ENV VITE_ACCEPTANCE_ADMIN_PASSWORD=${VITE_ACCEPTANCE_ADMIN_PASSWORD}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json
COPY frontend/tsconfig.json frontend/tsconfig.json
COPY frontend/vite.config.ts frontend/vite.config.ts
COPY frontend/index.html frontend/index.html
COPY frontend/src frontend/src

RUN pnpm install --frozen-lockfile
RUN pnpm --filter ai-order-platform-frontend build

FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="ai-order-platform-frontend-acceptance"
LABEL org.opencontainers.image.description="Isolated acceptance frontend with temporary visible credentials"

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html

EXPOSE 80
